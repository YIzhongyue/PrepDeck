.claude/settings.local.json
node_modules/
dist/
.wrangler/
# .dev.vars holds local development secrets; wrangler also reads per-environment
# siblings (.dev.vars.development, .dev.vars.preview, …), which are equally
# local-only and must never be committed.
.dev.vars
.dev.vars.*
!.dev.vars.example
*.local
.DS_Store
Thumbs.db
*.log
coverage/
__pycache__/
*.pyc
.env
.env.*
!.env.example

# Precompiled prompt templates (apps/worker/scripts/precompile-prompts.mjs),
# regenerated from apps/worker/prompts/*.njk via the predev/predeploy/
# pretypecheck npm hooks.
apps/worker/src/prompts/generated/

# Miniflare's persisted local D1/R2/KV/Durable Object state, written when a
# local run is given `--persist-to .local-state` (the default `.wrangler/`
# location is already ignored above). Purely a local development database:
# it is recreated on the next run and must never be committed.
.local-state/

# Git worktrees checked out inside the repository. The working copies they
# contain are already-tracked files belonging to another branch, so committing
# them would duplicate the tree into itself. Remove one with
# `git worktree remove <path>`, not `rm -rf`, so Git's own registration in
# .git/worktrees goes with it.
.worktrees/

# Local source PDFs and conversion workspaces.
/tmp/
