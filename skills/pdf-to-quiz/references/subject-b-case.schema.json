{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrepDeck Japanese SG Subject B case inventory extension",
  "description": "Local evidence inventory extension. Compile reviewed cases with build_quiz.py to the standard 1.0 import before sending to REST or MCP.",
  "type": "object",
  "required": ["caseSchemaVersion", "cases", "questions"],
  "properties": {
    "caseSchemaVersion": { "const": "1.0" },
    "cases": { "type": "array", "items": { "$ref": "#/definitions/case" } },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseId", "subquestionId"],
        "properties": {
          "caseId": { "$ref": "#/definitions/text" },
          "subquestionId": { "$ref": "#/definitions/text" },
          "optionTable": { "$ref": "#/definitions/optionTable" }
        }
      }
    }
  },
  "definitions": {
    "text": { "type": "string", "pattern": "[^\\s\\u0085\\u001c-\\u001f\\ufeff]" },
    "refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/text" } },
    "optionTable": {
      "type": "object", "additionalProperties": false,
      "required": ["columns", "rows", "blockRefs"],
      "properties": {
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } },
        "blockRefs": { "$ref": "#/definitions/refs" },
        "rows": {
          "type": "array", "minItems": 2, "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "values", "blockRefs"],
            "properties": {
              "id": { "$ref": "#/definitions/text" },
              "values": { "type": "array", "items": { "type": "string" } },
              "blockRefs": { "$ref": "#/definitions/refs" }
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceQuestionId", "expectedSubquestions", "reviewed", "materials"],
      "properties": {
        "id": { "$ref": "#/definitions/text" },
        "sourceQuestionId": { "$ref": "#/definitions/text" },
        "expectedSubquestions": { "type": "integer", "minimum": 1 },
        "reviewed": { "type": "boolean" },
        "materials": { "type": "array", "items": { "$ref": "#/definitions/material" } }
      }
    },
    "material": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "text", "blockRefs"],
          "properties": {
            "id": { "$ref": "#/definitions/text" }, "kind": { "const": "text" },
            "text": { "$ref": "#/definitions/text" }, "blockRefs": { "$ref": "#/definitions/refs" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "caption", "columns", "rows", "blockRefs"],
          "properties": {
            "id": { "$ref": "#/definitions/text" }, "kind": { "const": "table" },
            "caption": { "type": "string" },
            "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } },
            "rows": { "type": "array", "minItems": 1, "items": { "type": "array", "items": { "type": "string" } } },
            "blockRefs": { "$ref": "#/definitions/refs" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "description", "textSufficient", "blockRefs"],
          "properties": {
            "id": { "$ref": "#/definitions/text" }, "kind": { "const": "figure" },
            "description": { "type": ["string", "null"] }, "textSufficient": { "type": "boolean" },
            "blockRefs": { "$ref": "#/definitions/refs" }
          }
        }
      ]
    }
  }
}
